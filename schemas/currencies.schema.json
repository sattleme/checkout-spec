{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sattleme/checkout-spec/schemas/currencies.schema.json",
  "title": "currencies.json",
  "type": "object",
  "properties": {
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "source": {
      "type": "string",
      "pattern": "^https://"
    },
    "published": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "currencies": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z]{3}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 8
      }
    }
  },
  "required": ["description", "source", "published", "currencies"],
  "additionalProperties": false
}
