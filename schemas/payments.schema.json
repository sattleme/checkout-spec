{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sattleme/checkout-spec/schemas/payments.schema.json",
  "title": "vectors/payments.json",
  "type": "object",
  "properties": {
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "invoice": {
      "type": "object",
      "properties": {
        "bolt11": {
          "type": "string"
        },
        "paymentHash": {
          "$ref": "common.schema.json#/$defs/hex32"
        },
        "verifyUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/unixSeconds"
        }
      },
      "required": ["bolt11", "paymentHash", "verifyUrl", "expiresAt"],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "now": {
            "$ref": "common.schema.json#/$defs/unixSeconds"
          },
          "http": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "body": true,
              "bodyText": {
                "type": "string"
              }
            },
            "required": ["status"],
            "additionalProperties": false,
            "not": {
              "properties": {
                "body": true,
                "bodyText": true
              },
              "required": ["body", "bodyText"]
            }
          },
          "expected": {
            "$ref": "common.schema.json#/$defs/paymentStatus"
          }
        },
        "required": ["name", "now", "http", "expected"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "stored": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "invoice": {
            "type": "object"
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "valid": {
                    "const": true
                  }
                },
                "required": ["valid"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "error": {
                    "const": "invalid_order"
                  },
                  "param": {
                    "const": "invoice"
                  }
                },
                "required": ["error", "param"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": ["name", "invoice", "expected"],
        "additionalProperties": false
      }
    }
  },
  "required": ["description", "invoice", "cases", "stored"],
  "additionalProperties": false
}
