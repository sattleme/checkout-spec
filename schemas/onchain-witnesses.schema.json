{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sattleme/checkout-spec/schemas/onchain-witnesses.schema.json",
  "title": "vectors/onchain-witnesses.json",
  "type": "object",
  "properties": {
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "integrationKey": {
      "$ref": "common.schema.json#/$defs/hex32"
    },
    "channelEncryptionKey": {
      "$ref": "common.schema.json#/$defs/hex32"
    },
    "sale": {
      "$ref": "common.schema.json#/$defs/hex32"
    },
    "derived": {
      "type": "object",
      "properties": {
        "seenSecret": {
          "$ref": "common.schema.json#/$defs/hex32"
        },
        "seenAuthor": {
          "$ref": "common.schema.json#/$defs/hex32"
        },
        "seenAddressKey": {
          "$ref": "common.schema.json#/$defs/hex32"
        }
      },
      "required": ["seenSecret", "seenAuthor", "seenAddressKey"],
      "additionalProperties": false
    },
    "addresses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "$ref": "common.schema.json#/$defs/depositAddress"
          },
          "txid": {
            "$ref": "common.schema.json#/$defs/hex32"
          },
          "sale": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/hex32"
              },
              {
                "type": "null"
              }
            ]
          },
          "witnessAddress": {
            "$ref": "common.schema.json#/$defs/hex32"
          }
        },
        "required": ["address", "txid", "sale", "witnessAddress"],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "const": "newer"
              },
              {
                "type": "object",
                "properties": {
                  "version": {
                    "const": 1
                  },
                  "address": {
                    "$ref": "common.schema.json#/$defs/depositAddress"
                  },
                  "txid": {
                    "$ref": "common.schema.json#/$defs/hex32"
                  },
                  "sale": {
                    "oneOf": [
                      {
                        "$ref": "common.schema.json#/$defs/hex32"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sats": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2100000000000000
                  },
                  "inputs": {
                    "type": "array",
                    "maxItems": 100,
                    "uniqueItems": true,
                    "items": {
                      "$ref": "common.schema.json#/$defs/coin"
                    }
                  },
                  "replacement": {
                    "type": "boolean"
                  },
                  "expiresAt": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "common.schema.json#/$defs/unixSeconds"
                      }
                    ]
                  }
                },
                "required": [
                  "version",
                  "address",
                  "txid",
                  "sale",
                  "sats",
                  "inputs",
                  "replacement",
                  "expiresAt"
                ],
                "additionalProperties": false
              }
            ]
          },
          "names": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/depositAddress"
            }
          },
          "event": {
            "$ref": "common.schema.json#/$defs/event"
          }
        },
        "required": ["name", "value", "names", "event"],
        "additionalProperties": false
      }
    },
    "orderTags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "$ref": "common.schema.json#/$defs/depositAddress"
          },
          "sale": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/hex32"
              },
              {
                "type": "null"
              }
            ]
          },
          "orderTag": {
            "$ref": "common.schema.json#/$defs/hex32"
          }
        },
        "required": ["address", "sale", "orderTag"],
        "additionalProperties": false
      }
    },
    "addressTags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "$ref": "common.schema.json#/$defs/depositAddress"
          },
          "addressTag": {
            "$ref": "common.schema.json#/$defs/hex32"
          }
        },
        "required": ["address", "addressTag"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "description",
    "integrationKey",
    "channelEncryptionKey",
    "sale",
    "derived",
    "addresses",
    "orderTags",
    "addressTags",
    "events"
  ],
  "additionalProperties": false
}
