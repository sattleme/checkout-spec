{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sattleme/checkout-spec/schemas/common.schema.json",
  "title": "Definitions shared by the schemas",
  "$defs": {
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hex16": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sig": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digits": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "unixSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "error": {
      "type": "object",
      "properties": {
        "error": {
          "enum": [
            "invalid_key",
            "invalid_option",
            "invalid_order",
            "revoked",
            "channel_not_found",
            "network",
            "invalid_invoice",
            "invoice_pending",
            "order_paid",
            "unsupported_currency",
            "rate",
            "checkout_unavailable",
            "onchain_unavailable"
          ]
        },
        "param": {
          "enum": [
            "options",
            "rateSource",
            "coingeckoApiKey",
            "fetch",
            "WebSocket",
            "relayTimeoutMs",
            "httpTimeoutMs",
            "logger",
            "now",
            "random",
            "intervalMs",
            "onStatus",
            "order",
            "ref",
            "sats",
            "fiat",
            "durationSeconds",
            "note",
            "checkout",
            "redirectUrl",
            "invoice"
          ]
        }
      },
      "required": ["error"],
      "additionalProperties": false
    },
    "fiatInput": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        }
      },
      "required": ["amount", "currency"],
      "additionalProperties": false
    },
    "declaredFiat": {
      "type": "object",
      "properties": {
        "minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "digits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": ["minor", "digits", "currency"],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "integer"
        },
        "created_at": {
          "type": "integer",
          "minimum": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "minItems": 0
        },
        "content": {
          "type": "string"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/hex32"
        },
        "pubkey": {
          "$ref": "common.schema.json#/$defs/hex32"
        },
        "sig": {
          "$ref": "common.schema.json#/$defs/sig"
        }
      },
      "required": ["kind", "created_at", "tags", "content", "id", "pubkey", "sig"],
      "additionalProperties": false
    },
    "relays": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^wss://"
      },
      "minItems": 1,
      "maxItems": 10
    },
    "checkoutValue": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "businessName": {
          "type": "string"
        },
        "invoice": {
          "type": "string"
        },
        "verifyUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "fiat": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/declaredFiat"
            }
          ]
        },
        "note": {
          "type": "string"
        },
        "redirectUrl": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "version",
        "businessName",
        "invoice",
        "verifyUrl",
        "fiat",
        "note",
        "redirectUrl"
      ],
      "additionalProperties": false
    },
    "depositAddress": {
      "type": "string",
      "pattern": "^bc1p[02-9ac-hj-np-z]{58}$"
    },
    "paymentStatus": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "open"
            },
            "expiresAt": {
              "$ref": "#/$defs/unixSeconds"
            },
            "received": {
              "$ref": "#/$defs/digits"
            },
            "rest": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/rest"
                }
              ]
            }
          },
          "required": ["state", "expiresAt", "received", "rest"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "unconfirmed"
            },
            "received": {
              "$ref": "#/$defs/digits"
            },
            "confirmations": {
              "type": "integer",
              "minimum": 0
            },
            "txids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/hex32"
              },
              "minItems": 1
            }
          },
          "required": ["state", "received", "confirmations", "txids"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "paid"
            },
            "method": {
              "const": "lightning"
            },
            "preimage": {
              "$ref": "#/$defs/hex32"
            }
          },
          "required": ["state", "method", "preimage"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "paid"
            },
            "method": {
              "const": "onchain"
            },
            "received": {
              "$ref": "#/$defs/digits"
            },
            "txids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/hex32"
              },
              "minItems": 1
            }
          },
          "required": ["state", "method", "received", "txids"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "paid"
            },
            "method": {
              "const": "mixed"
            },
            "received": {
              "$ref": "#/$defs/digits"
            },
            "txids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/hex32"
              }
            },
            "preimages": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/hex32"
              },
              "minItems": 1
            }
          },
          "required": ["state", "method", "received", "txids", "preimages"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "expired"
            },
            "received": {
              "$ref": "#/$defs/digits"
            }
          },
          "required": ["state", "received"],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    },
    "coin": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}:(0|[1-9][0-9]{0,9})$",
      "description": "A coin a transaction spends: <txid>:<vout> (SPEC.md \u00a731, Explorers)."
    },
    "rest": {
      "type": "object",
      "properties": {
        "sats": {
          "$ref": "#/$defs/digits"
        },
        "bolt11": {
          "type": ["string", "null"],
          "pattern": "^lnbc"
        },
        "paymentUri": {
          "type": ["string", "null"],
          "pattern": "^(bitcoin|lightning):"
        }
      },
      "required": ["sats", "bolt11", "paymentUri"],
      "additionalProperties": false
    },
    "payRequest": {
      "type": "object",
      "properties": {
        "tag": {
          "const": "payRequest"
        },
        "callback": {
          "type": "string",
          "pattern": "^https://"
        },
        "minSendable": {
          "type": "integer",
          "minimum": 0
        },
        "maxSendable": {
          "type": "integer",
          "minimum": 0
        },
        "metadata": {
          "type": "string"
        },
        "commentAllowed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["tag", "callback", "minSendable", "maxSendable", "metadata", "commentAllowed"],
      "additionalProperties": false
    }
  }
}
