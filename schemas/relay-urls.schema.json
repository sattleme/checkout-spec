{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sattleme/checkout-spec/schemas/relay-urls.schema.json",
  "title": "vectors/relay-urls.json",
  "type": "object",
  "properties": {
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          }
        },
        "required": ["url", "valid"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": ["description", "cases"],
  "additionalProperties": false
}
