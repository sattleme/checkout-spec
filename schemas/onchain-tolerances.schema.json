{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sattleme/checkout-spec/schemas/onchain-tolerances.schema.json",
  "title": "vectors/onchain-tolerances.json",
  "type": "object",
  "properties": {
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "expected": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "required": ["name", "expected"],
        "additionalProperties": false
      }
    },
    "accepted": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "sats": {
            "$ref": "common.schema.json#/$defs/digits"
          },
          "tolerance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "expected": {
            "$ref": "common.schema.json#/$defs/digits"
          }
        },
        "required": ["sats", "tolerance", "expected"],
        "additionalProperties": false
      }
    },
    "due": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "sats": {
            "$ref": "common.schema.json#/$defs/digits"
          },
          "tolerance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "paidByRests": {
            "$ref": "common.schema.json#/$defs/digits"
          },
          "merchantAccepted": {
            "$ref": "common.schema.json#/$defs/digits"
          },
          "expected": {
            "$ref": "common.schema.json#/$defs/digits"
          }
        },
        "required": ["sats", "tolerance", "paidByRests", "expected"],
        "additionalProperties": false
      }
    }
  },
  "required": ["description", "values", "accepted", "due"],
  "additionalProperties": false
}
