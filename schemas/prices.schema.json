{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sattleme/checkout-spec/schemas/prices.schema.json",
  "title": "vectors/prices.json",
  "type": "object",
  "properties": {
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "text": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "price": {
            "type": "string"
          },
          "expected": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["price", "expected"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "numbers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          },
          "expected": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["json", "expected"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": ["description", "text", "numbers"],
  "additionalProperties": false
}
