{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sattleme/checkout-spec/schemas/onchain-addresses.schema.json",
  "title": "vectors/onchain-addresses.json",
  "type": "object",
  "properties": {
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "addresses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          }
        },
        "required": ["name", "address", "valid"],
        "additionalProperties": false
      }
    },
    "registry": {
      "type": "object",
      "properties": {
        "registryKey": {
          "$ref": "common.schema.json#/$defs/hex32"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "address": {
                "$ref": "common.schema.json#/$defs/depositAddress"
              },
              "registryAddress": {
                "$ref": "common.schema.json#/$defs/hex32"
              }
            },
            "required": ["address", "registryAddress"],
            "additionalProperties": false
          }
        }
      },
      "required": ["registryKey", "cases"],
      "additionalProperties": false
    },
    "uris": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/depositAddress"
              },
              {
                "type": "null"
              }
            ]
          },
          "sats": {
            "$ref": "common.schema.json#/$defs/digits"
          },
          "bolt11": {
            "type": ["string", "null"]
          },
          "uri": {
            "type": "string",
            "pattern": "^(bitcoin|lightning):"
          }
        },
        "required": ["name", "address", "sats", "bolt11", "uri"],
        "additionalProperties": false
      }
    },
    "amounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "sats": {
            "$ref": "common.schema.json#/$defs/digits"
          },
          "btc": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
          }
        },
        "required": ["sats", "btc"],
        "additionalProperties": false
      }
    }
  },
  "required": ["description", "addresses", "registry", "uris", "amounts"],
  "additionalProperties": false
}
