{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sattleme/checkout-spec/schemas/implementation-declaration.schema.json",
  "title": "vectors/app/implementation-declaration.json",
  "type": "object",
  "properties": {
    "source": {
      "$ref": "common.schema.json#/$defs/source"
    },
    "ref": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "fiat": {
      "$ref": "common.schema.json#/$defs/declaredFiat"
    },
    "sats": {
      "$ref": "common.schema.json#/$defs/digits"
    },
    "invoice": {
      "type": "string"
    },
    "paymentHash": {
      "$ref": "common.schema.json#/$defs/hex32"
    },
    "verifyUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "saleAuthor": {
      "$ref": "common.schema.json#/$defs/hex32"
    },
    "taker": {
      "$ref": "common.schema.json#/$defs/hex16"
    },
    "event": {
      "$ref": "common.schema.json#/$defs/event"
    }
  },
  "required": [
    "source",
    "ref",
    "note",
    "fiat",
    "sats",
    "invoice",
    "paymentHash",
    "verifyUrl",
    "saleAuthor",
    "taker",
    "event"
  ],
  "additionalProperties": false
}
