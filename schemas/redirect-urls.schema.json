{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sattleme/checkout-spec/schemas/redirect-urls.schema.json",
  "title": "vectors/redirect-urls.json",
  "type": "object",
  "properties": {
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "shown": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["shown"],
                "additionalProperties": false
              },
              {
                "$ref": "common.schema.json#/$defs/error"
              }
            ]
          }
        },
        "required": ["url", "expected"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": ["description", "cases"],
  "additionalProperties": false
}
