{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sattleme/checkout-spec/schemas/pay-requests.schema.json",
  "title": "vectors/pay-requests.json",
  "type": "object",
  "properties": {
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "http": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "body": true,
              "bodyText": {
                "type": "string"
              }
            },
            "required": ["status"],
            "additionalProperties": false,
            "not": {
              "properties": {
                "body": true,
                "bodyText": true
              },
              "required": ["body", "bodyText"]
            }
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "callback": {
                    "type": "string",
                    "pattern": "^https://"
                  },
                  "sendable": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "$ref": "common.schema.json#/$defs/digits"
                      },
                      "max": {
                        "$ref": "common.schema.json#/$defs/digits"
                      }
                    },
                    "required": ["min", "max"],
                    "additionalProperties": false
                  },
                  "commentAllowed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "descriptionHash": {
                    "$ref": "common.schema.json#/$defs/sha256"
                  }
                },
                "required": ["callback", "sendable", "commentAllowed", "descriptionHash"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "error": {
                    "enum": ["invalid_invoice", "network"]
                  }
                },
                "required": ["error"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": ["name", "http", "expected"],
        "additionalProperties": false
      }
    }
  },
  "required": ["description", "cases"],
  "additionalProperties": false
}
