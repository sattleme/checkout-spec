{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sattleme/checkout-spec/schemas/order-text.schema.json",
  "title": "vectors/order-text.json",
  "type": "object",
  "properties": {
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          }
        },
        "required": ["ref", "valid"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  }
                },
                "required": ["label"],
                "additionalProperties": false
              },
              {
                "$ref": "common.schema.json#/$defs/error"
              }
            ]
          }
        },
        "required": ["ref", "note", "expected"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "commentAllowed": {
            "type": "integer",
            "minimum": 0
          },
          "sent": {
            "type": "boolean"
          }
        },
        "required": ["label", "commentAllowed", "sent"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": ["description", "refs", "notes", "comments"],
  "additionalProperties": false
}
